# ==========================================================
# EVIDENROUTE ENVIRONMENT CONFIGURATION
# Phase 1: Local-first Context Selection Engine
# ==========================================================

# Application Settings
ENVIRONMENT=development
APP_NAME=EvidenRoute Intelligence Engine
API_V1_STR=/api/intelligence
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS Configuration (React Frontend)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database Configuration (Placeholder for Member 1's PostgreSQL integration)
# Note: Phase 1 runs in-memory with local registries. No live DB connection required.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=evidenroute
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# Source Selection Scoring Weights (Sum = 1.0)
WEIGHT_RELEVANCE=0.35
WEIGHT_SUITABILITY=0.25
WEIGHT_AUTHORITY=0.20
WEIGHT_HISTORICAL=0.10
WEIGHT_AVAILABILITY=0.10

# Source Selection Thresholds
SELECTION_THRESHOLD=0.40
MIN_RELEVANCE_THRESHOLD=0.15

# External LLM Settings (Disabled in Phase 1 - Local-first rule)
LLM_PROVIDER=none
GEMINI_API_KEY=
